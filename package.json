{
  "name": "d3-hypertree",
  "main": "dist/d3-hypertree.js",
  "types": "dist/d/d3-hypertree.d.ts",
  "version": "1.1.3",
  "description": "Hyperbolictree",
  "author": "Michael Glatzhofer",
  "license": "MIT",
  "homepage": "https://github.com/glouwa/d3-hypertree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glouwa/d3-hypertree.git"
  },
  "keywords": [
    "hyperbolic tree",
    "hyper tree"
  ],
  "scripts": {
    "build": "vite build && node build/css.mjs && npm run build:types",
    "build:types": "node build/types.mjs",
    "typecheck": "tsc -p . --noEmit --emitDeclarationOnly false",
    "watch": "node build/watch.mjs",
    "dev": "node build/watch.mjs --playground",
    "run": "node build/watch.mjs",
    "playground": "browser-sync start --server --port 3100 --ui-port 3101 --startPath /playground/ --files \"dist/*.js\" \"dist/*.css\" \"playground/*\" \"test/config.js\" --no-open --no-notify",
    "lint": "eslint src"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "browser-sync": "^3.0.4",
    "eslint": "^10.15.0",
    "events": "^3.3.0",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "module": "dist/d3-hypertree.mjs",
  "exports": {
    ".": {
      "types": "./dist/d/d3-hypertree.d.ts",
      "import": "./dist/d3-hypertree.mjs",
      "require": "./dist/d3-hypertree.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  }
}
