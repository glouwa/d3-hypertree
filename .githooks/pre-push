#!/bin/sh
# Before every push: measure the pushed state with the performance suite and write
# docs/dev/performance/last-push (docs/dev/PERFORMANCE-SUITE.md). Runs in the
# background, the push is not held up; the suite waits for another measurement to
# finish and refuses a dirty working tree (then the log says so).
# Installed by `npm run hooks` (git config core.hooksPath .githooks).
cd "$(git rev-parse --show-toplevel)" || exit 0
mkdir -p docs/dev/performance
nohup node test/perf/run.mjs --write push > docs/dev/performance/last-push.log 2>&1 &
exit 0
